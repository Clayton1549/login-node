<!DOCTYPE html>
<html lang="pt-br">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Excluir conta usuário</title>
</head>
 <body>
   <%-include('../views/autentic'); %>
  <div class="container">
    <% if(typeof Username !== 'undefined') { %>
     <h1 class="text-info">Seja bem vindo: <%= Username %>!</h1>
    <% } else { %>
     <p>Faça login</p>
    <% } %>
    <h3> Tem certeza que deseja excluir a conta?</h3>
    <table class="table table-striped table-bordered   border-primary">
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Senha</th>
            <th>Email</th>
           
            <th>Delete</th>
        </tr>
        <%
           if(userData.length!=0){
           var i=1;
           userData.forEach(function(data){
           
          %>
          
        <tr>
            <td><%=i; %></td>
            <td><%=data.username;  %></td>
            <td><%=data.password %></td>
            <td><%=data.email %></td>
            <td> <form action="/excluirUser" method="post">
                   <button class="btn btn-outline-success">Sim</button>
                 </form>
            </td>
        </tr>
        <%  i++; }) %>
        <% } else{ %>
            <tr>
                <td colspan="7">No Data Found</td>
            </tr>
        <% } %>
     </table>
    

  </body>
</html>