<!DOCTYPE html>
<html lang="pt-br">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Editar conta usuario  </title>
</head>
 
<body>
    <%- include('../views/autentic');  %>
   
   <div class="container">
    <% if(typeof Username !== 'undefined') { %>
     <h1 class="text-info">Seja bem vindo: <%= Username %>!</h1>
    <%} else { %>
     <p>Faça login</p>
    <% } %>
  
	 <h1> Editar usuario js </h1>


    <table class="table table-striped table-bordered border-primary">
        <tr>
            <th>Nome</th>
            <th>Senha</th>
            <th>Email</th>
            <td>Enviar</td>
         </tr>
      
        <tr>
            <%
              if(userData.length!=0){
              var i=1;
             userData.forEach(function(data){
             %>
           
            <td>
              <form method="post" action="/update">
              <input class="form-control" type="text" name="username"  id="username" value= "<%=data.username %>" ></td>
            
             <td><input class="form-control" type="text" name="password"  value="<%=data.password %>"></td>
            
            <td><input class="form-control" type="email" name="email" value="<%=data.email %>"></td>
            
            <td>
              <button class="btn btn-info">Salvar</button>
             </form></td>
          
          </tr>
        <%  i++; }) %>
        <% } else{ %>
            <tr>
                <td colspan="7">No Data Found</td>
            </tr>
        <% } %>
     </table>
    </div>
  </div>
</div>

 <br><br><br>
 <%- include('../views/footer') %>
	
  </body>
</html>