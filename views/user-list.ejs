<!DOCTYPE html>
<html lang="pt-br">
<head>
  <title>Fetch using MySQL and Node.js</title>
  
</head>
<body >
    <%-include('../views/autentic'); %>
  <div class="container">
    <% if(typeof Username !== 'undefined') { %>
     <h1 class="text-info">Seja bem vindo: <%= Username %>!</h1>
    <% } else { %>
     <p>Faça login</p>
    <% } %>

<div class="table-data">
  <h2>Display Data using Node.js & MySQL</h2>
    <table class="table table-striped table-bordered   border-primary">
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Senha</th>
            <th>Email</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
        <%
           if(userData.length!=0){
           var i=1;
           userData.forEach(function(data){
           
          %>
          
        <tr>
            <td><%=i; %></td>
            <td><%=data.username;  %></td>
            <td><%=data.password %></td>
            <td><%=data.email %></td>
            <td><a href="/edite">Edit</a></td>
            <td><a href="/delete">Delete</a></td>
        </tr>
        <%  i++; }) %>
        <% } else{ %>
            <tr>
                <td colspan="7">No Data Found</td>
            </tr>
        <% } %>
     </table>
    </div>
 </div>
 <br><br><br>
 <%- include('../views/footer') %>
</body>
</html>
